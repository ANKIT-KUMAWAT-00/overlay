{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist/renderer",
    "rootDir": "src/renderer",
    "sourceMap": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"]
  },
  "include": ["src/renderer/**/*", "src/shared/**/*"]
}
