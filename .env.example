# ==============================================================================
# Universal AI Desktop Assistant Configuration Example
# ==============================================================================

# Gemini API Key (Required for AI operations)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default AI Model (Options: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Global Shortcuts
# macOS Activation Default: Command+Shift+Z
# Windows Activation Default: Ctrl+Shift+Z
# Global Answer Insertion Default: Alt+Enter
ACTIVATION_SHORTCUT_DARWIN=Command+Shift+Z
ACTIVATION_SHORTCUT_WIN32=Ctrl+Shift+Z
INSERTION_SHORTCUT=Alt+Enter

# Privacy & Telemetry
# Strict privacy: no local logging of prompts, zero external telemetry
ASSISTANT_PRIVACY_MODE=true
ENABLE_HISTORY=false

# Timeouts & Retries
MAX_RETRY_ATTEMPTS=3
RETRY_TIMEOUT_MS=35000
