# ==============================================================================
# OmniAssist Configuration Environment Template
# ==============================================================================
# Never commit your actual API key to version control.
# Prefer saving it securely into the OS credential store via the Settings GUI
# or by setting GEMINI_API_KEY below.

# Google Gemini API Key
GEMINI_API_KEY=

# Optional alternative environment variable name
GOOGLE_API_KEY=

# Default Model Selection
# Options: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# OCR Engine Path (optional override if tesseract is not in system PATH)
# macOS (Homebrew): /opt/homebrew/bin/tesseract or /usr/local/bin/tesseract
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
